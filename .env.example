# Public origin used for SIWE domain binding and CSRF origin checks.
APP_ORIGIN=https://www.trait-forge.art

# Neon/PostgreSQL connection string. Keep this server-only.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate each secret independently with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
CODE_PEPPER=replace-with-a-different-32-byte-random-secret

# Base mainnet USDC payment wall. This is a public receiving address, never a private key.
BASE_PAYMENT_ADDRESS=0xC7A7Ca7D3cfD3e8442c5A57a42A46fD655738276
# The official public RPC needs no registration but is rate limited. You may replace it with your own node URL.
BASE_RPC_URL=https://mainnet.base.org
MIN_USDC_CONFIRMATIONS=5

# Use a private production RPC provider; the public Robinhood endpoint is rate limited.
ROBINHOOD_RPC_URL=https://your-robinhood-mainnet-rpc.example
MIN_BURN_CONFIRMATIONS=20

# Required by the future private source-upload/server generation worker.
BLOB_READ_WRITE_TOKEN=
